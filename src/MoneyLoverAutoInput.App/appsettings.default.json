{
  // Cấu hình mặc định. Lần chạy đầu, file này được copy sang
  // %LOCALAPPDATA%\MoneyLoverAutoInput\appsettings.json — hãy sửa file đó, không sửa file này.
  // Màn "Thiết lập" trong app cũng ghi vào file đó (comment sẽ mất khi lưu từ app).
  //
  // Money Lover đang để giao diện TIẾNG ANH: tên nhóm, ví và selector bên dưới theo tiếng Anh.

  "SetupCompleted": false,                // false = lần đầu mở app sẽ vào màn Thiết lập

  "Tools": {
    "AdbPath": "",                       // trống = ANDROID_HOME\platform-tools\adb.exe, rồi PATH
    "AppiumCommand": "appium",
    "AutoStartAppium": true
  },
  "Appium": {
    "ServerUrl": "http://127.0.0.1:4723",
    "Udid": "",                          // trống = thiết bị duy nhất; Wi-Fi: "192.168.1.20:41xxx"
    "AppPackage": "com.bookmark.money",  // xác minh: adb shell dumpsys window | findstr mCurrentFocus
    "NewCommandTimeoutSec": 300
  },
  "Timing": {
    "DefaultWaitSec": 10,
    "DelayBetweenRowsMs": 800,
    "RetryPerRow": 2
  },
  "Defaults": {
    "Wallet": "TP Bank",                 // tên ví CHÍNH XÁC trong Money Lover (khác ví "TPBank" viết liền)
    "CreditCardWallet": "",              // ví cho file "Lịch sử giao dịch thẻ tín dụng"; trống = dùng Wallet
    "BidvWallet": "",                    // ví cho bảng giao dịch BIDV (file không có số TK); trống = dùng Wallet
    "ManualWallet": "Cash",              // ví mặc định trên màn "Nhập tay"; trống = dùng Wallet
    "ExpenseCategory": "Other Expense",  // trống = dòng không khớp luật bị báo "Chưa phân loại"
    "IncomeCategory": "Other Income",
    "NoteTemplate": "{description}"      // {description}, {counterpartName}, {txnCode}
  },
  "Wallets": {
    // "số tài khoản": "tên ví trong app"
  },
  // Các ví đang dùng trong Money Lover (tên chính xác) — để chọn ví cho từng giao dịch trên Xem trước.
  "KnownWallets": [ "TP Bank", "Cash" ],
  "KnownCategories": {
    // Cây nhóm như trong app: nhóm cha + "Children" (nhóm con). Ở nơi khác nhóm con viết là "Cha > Con".
    // Đây là nhóm MẶC ĐỊNH của Money Lover bản tiếng Anh — sửa cho đúng app của bạn ở màn Thiết lập.
    "Chi": [
      { "Name": "Bills & Utilities", "Children": [ "Electricity Bill", "Internet Bill", "Phone Bill", "Water Bill" ] },
      { "Name": "Entertainment",     "Children": [ "Games", "Movies" ] },
      { "Name": "Food & Beverage",   "Children": [ "Café", "Restaurants" ] },
      { "Name": "Health & Fitness",  "Children": [ "Fitness", "Medical Check-up" ] },
      { "Name": "Shopping",          "Children": [ "Clothing", "Electronics", "Houseware" ] },
      { "Name": "Transportation",    "Children": [ "Parking Fees", "Petrol", "Taxi" ] },
      { "Name": "Other Expense" }
    ],
    "Thu": [
      { "Name": "Salary" },
      { "Name": "Incoming transfer" },
      { "Name": "Other Income" }
    ]
  },
  "CategoryRules": [
    // Luật đầu tiên khớp sẽ thắng. Đây chỉ là VÍ DỤ — sửa theo giao dịch thật của bạn.
    // "TT QR" và "NAP TIEN VI MOMO" là kênh thanh toán, không cho biết mua gì → để nhóm mặc định rồi sửa tay.
    { "match": [ "TIEN NUOC", "CAP NUOC" ],          "type": "Chi", "category": "Bills & Utilities > Water Bill" },
    { "match": [ "TIEN DIEN", "EVN" ],               "type": "Chi", "category": "Bills & Utilities > Electricity Bill" },
    { "match": [ "GRAB", "BE GROUP", "XANH SM" ],    "type": "Chi", "category": "Transportation > Taxi" },
    { "match": [ "SHOPEE", "LAZADA", "TIKI" ],       "type": "Chi", "category": "Shopping" },
    { "match": [ "LUONG", "SALARY" ],                "type": "Thu", "category": "Salary" },
    { "match": [ "CK DEN", "NHAN TIEN", "CHUYEN TIEN DEN" ], "type": "Thu", "category": "Incoming transfer" }
  ],
  "Selectors": {
    // Lấy từ uiautomator dump thật (Money Lover 8.93.0, giao diện tiếng Anh, 16/11/2026) — SPEC mục 12.
    // by: id | text | accessibilityId | uiautomator. {d} = chữ số 1–9, {name} = tên ví/nhóm (khớp CHÍNH XÁC).
    // --- Màn chính ---
    "AddButton":          { "by": "id", "value": "com.bookmark.money:id/btAddTransaction" },
    // --- Màn Add transaction (ActivityEditTransaction) ---
    "TypeTabExpense":     { "by": "text", "value": "Expense" },
    "TypeTabIncome":      { "by": "text", "value": "Income" },
    "WalletField":        { "by": "id", "value": "com.bookmark.money:id/wallet_button" },
    "WalletText":         { "by": "id", "value": "com.bookmark.money:id/wallet" },
    "AmountField":        { "by": "id", "value": "com.bookmark.money:id/amount_text" },
    "KeypadDigit":        { "by": "id", "value": "com.bookmark.money:id/button{d}" },
    "KeypadZero":         { "by": "id", "value": "com.bookmark.money:id/button14" },
    "KeypadTripleZero":   { "by": "id", "value": "com.bookmark.money:id/button21" },
    "KeypadClear":        { "by": "id", "value": "com.bookmark.money:id/button17" },
    "KeypadBackspace":    { "by": "id", "value": "com.bookmark.money:id/button16" },
    "KeypadNext":         { "by": "id", "value": "com.bookmark.money:id/button19" },
    "CategoryField":      { "by": "id", "value": "com.bookmark.money:id/category_button" },
    "CategoryText":       { "by": "id", "value": "com.bookmark.money:id/category" },
    "NoteField":          { "by": "id", "value": "com.bookmark.money:id/note" },
    "DateText":           { "by": "id", "value": "com.bookmark.money:id/date" },
    "DatePrev":           { "by": "id", "value": "com.bookmark.money:id/ivPreviousDate" },
    "DateNext":           { "by": "id", "value": "com.bookmark.money:id/ivNextDate" },
    "SaveButton":         { "by": "id", "value": "com.bookmark.money:id/btn_save" },
    // --- Màn chọn nhóm (CategoryPickerActivity): nhóm có >2 con bị thu gọn sau "SHOW MORE…" ---
    "CategoryTabExpense": { "by": "accessibilityId", "value": "Expense" },
    "CategoryTabIncome":  { "by": "accessibilityId", "value": "Income" },
    "CategoryList":       { "by": "id", "value": "com.bookmark.money:id/recycler_view" },
    "CategoryItem":       { "by": "uiautomator", "value": "new UiSelector().resourceId(\"com.bookmark.money:id/name\").text(\"{name}\")" },
    "CategoryShowMore":   { "by": "uiautomator", "value": "new UiSelector().textStartsWith(\"SHOW MORE\")" },
    "CategoryRowName":    { "by": "id", "value": "com.bookmark.money:id/name" },            // đọc page source
    "CategoryChildIndicator": { "by": "id", "value": "com.bookmark.money:id/child_indicator" },
    // Hộp thoại "bỏ giao dịch đang nhập?" khi bấm Back — CHƯA xác minh, dùng nút mặc định của AlertDialog.
    "DiscardConfirm":     { "by": "id", "value": "android:id/button1" },
    // --- Màn chọn ví (ActivityWalletSwitcher): bấm vào tên ví, KHÔNG bấm nút menu ⋮ ---
    "WalletItem":         { "by": "uiautomator", "value": "new UiSelector().resourceId(\"com.bookmark.money:id/name\").text(\"{name}\")" },
    // --- Màn ghi chú (ActivityAddNote) ---
    "NoteEdit":           { "by": "id", "value": "com.bookmark.money:id/edtNote" },
    "NoteSave":           { "by": "id", "value": "com.bookmark.money:id/actionSave" }
  }
}
