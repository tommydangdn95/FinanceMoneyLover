{
  // Cấu hình mặc định. Lần chạy đầu, file này được copy sang
  // %LOCALAPPDATA%\MoneyLoverAutoInput\appsettings.json — hãy sửa file đó, không sửa file này.

  "Tools": {
    "AdbPath": "",                       // trống = ANDROID_HOME\platform-tools\adb.exe, rồi PATH
    "AppiumCommand": "appium",
    "AutoStartAppium": true
  },
  "Appium": {
    "ServerUrl": "http://127.0.0.1:4723",
    "Udid": "",                          // trống = thiết bị duy nhất; Wi-Fi: "192.168.1.20:41xxx"
    "AppPackage": "com.bookmark.money",  // xác minh: adb shell dumpsys window | findstr mCurrentFocus
    "NewCommandTimeoutSec": 300
  },
  "Timing": {
    "DefaultWaitSec": 10,
    "DelayBetweenRowsMs": 800,
    "RetryPerRow": 2
  },
  "Defaults": {
    "Wallet": "Tài khoản ngân hàng",    // tên ví trong Money Lover tương ứng với tài khoản sao kê
    "ExpenseCategory": "Khác",           // trống = dòng không khớp luật bị báo "Chưa phân loại"
    "IncomeCategory": "Thu nhập khác",
    "NoteTemplate": "{description}"      // {description}, {counterpartName}, {txnCode}
  },
  "Wallets": {
    // "số tài khoản": "tên ví trong app"
  },
  "KnownCategories": {
    // Sửa cho trùng đúng tên nhóm trong app của bạn.
    "Chi": [ "Ăn uống", "Di chuyển", "Mua sắm", "Hóa đơn", "Giải trí", "Sức khỏe", "Gia đình", "Khác" ],
    "Thu": [ "Lương", "Thưởng", "Được tặng", "Thu nhập khác" ]
  },
  "CategoryRules": [
    // Luật đầu tiên khớp sẽ thắng. Đây chỉ là VÍ DỤ — sửa theo giao dịch thật của bạn.
    { "match": [ "NAP TIEN VI MOMO" ],             "type": "Chi", "action": "Skip" },
    { "match": [ "GRAB", "BE GROUP", "XANH SM" ],  "type": "Chi", "category": "Di chuyển" },
    { "match": [ "SHOPEE", "LAZADA", "TIKI" ],     "type": "Chi", "category": "Mua sắm" },
    { "match": [ "LUONG", "SALARY" ],              "type": "Thu", "category": "Lương" }
  ],
  "Selectors": {
    // Điền sau khi soi UI bằng: adb shell uiautomator dump (SPEC mục 12).
    "AddButton":          { "by": "id",   "value": "TODO" },
    "AmountField":        { "by": "id",   "value": "TODO" },
    "KeypadDigit":        { "by": "xpath","value": "TODO" },
    "KeypadDone":         { "by": "text", "value": "TODO" },
    "CategoryField":      { "by": "text", "value": "Chọn nhóm" },
    "CategoryTabExpense": { "by": "text", "value": "TODO" },
    "CategoryTabIncome":  { "by": "text", "value": "TODO" },
    "CategoryItem":       { "by": "text", "value": "{name}" },
    "WalletField":        { "by": "id",   "value": "TODO" },
    "WalletItem":         { "by": "text", "value": "{name}" },
    "DateField":          { "by": "id",   "value": "TODO" },
    "NoteField":          { "by": "id",   "value": "TODO" },
    "SaveButton":         { "by": "text", "value": "Lưu" }
  }
}
