<UserControl x:Class="MoneyLoverAutoInput.App.Controls.SearchComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Self">
    <!--
        Ô nhập có gợi ý: TextBox thường + Popup danh sách. KHÔNG dùng ComboBox editable vì lọc danh sách của
        ComboBox làm nó tự đặt lại Text theo mục đang chọn → chữ người dùng gõ bị xóa mất.
    -->
    <Grid>
        <TextBox x:Name="Input" Padding="8,4,30,4" VerticalContentAlignment="Center"
                 IsReadOnly="{Binding IsReadOnly, ElementName=Self}" />
        <Button x:Name="Toggle" HorizontalAlignment="Right" Width="28" Margin="0,0,2,0"
                Focusable="False" IsTabStop="False" Padding="0"
                Background="Transparent" BorderThickness="0" Cursor="Arrow"
                ToolTip="Hiện tất cả">
            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Button>

        <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Focusable="False"
               MinWidth="{Binding ActualWidth, ElementName=Input}">
            <Border Margin="0,2,0,0" CornerRadius="6" BorderThickness="1" Padding="4"
                    MinWidth="240" MaxWidth="520"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                <Grid>
                    <ListBox x:Name="List" MaxHeight="320" Focusable="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <!-- Không cho mục nhận focus: focus phải ở lại ô nhập để gõ tiếp. -->
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="8,5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="NoMatch" Margin="8,6" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Không có mục nào khớp — giữ nguyên chữ đã gõ" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
