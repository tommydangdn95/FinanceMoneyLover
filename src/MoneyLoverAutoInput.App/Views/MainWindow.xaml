<ui:FluentWindow x:Class="MoneyLoverAutoInput.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
                 xmlns:views="clr-namespace:MoneyLoverAutoInput.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                 Title="Money Lover Auto Input"
                 Width="1440" Height="860" MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <views:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManualEntryViewModel}">
            <views:ManualEntryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
            <views:EnvironmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}">
            <views:RunView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Money Lover Auto Input" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Điều hướng -->
            <!-- Khóa điều hướng khi đang nhập (không sửa dữ liệu đang được nhập). -->
            <ListBox Grid.Column="0" Margin="8,4,4,8"
                     IsEnabled="{Binding Run.IsNotRunning}"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNav}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItem}">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Trang hiện tại -->
            <ContentControl Grid.Column="1" Margin="8,4,16,8"
                            Content="{Binding SelectedNav.Page}" />
        </Grid>

        <!-- Thanh trạng thái (SPEC 10.1) -->
        <Border Grid.Row="2" Padding="16,6"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Thiết bị: " /><Run Text="{Binding Environment.DeviceSummary, Mode=OneWay}" />
                    <Run Text="   ·   Appium: " /><Run Text="{Binding Environment.AppiumSummary, Mode=OneWay}" />
                    <Run Text="   ·   " />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Preview.FileName, StringFormat='Sao kê: {0}'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Preview.HasFile}" Value="False">
                                    <Setter Property="Text" Value="Chưa mở sao kê" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
