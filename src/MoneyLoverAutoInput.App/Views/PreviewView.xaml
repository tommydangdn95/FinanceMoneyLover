<UserControl x:Class="MoneyLoverAutoInput.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
             xmlns:views="clr-namespace:MoneyLoverAutoInput.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + chọn file -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="Xem trước" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="DocumentTable24" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding FileName}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16,0,0,0"
                               Text="{Binding AccountMasked, StringFormat='Tài khoản: {0}'}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16,0,0,0"
                               Text="{Binding Period, StringFormat='Kỳ: {0}'}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Đọc lại file" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"
                           Command="{Binding ReloadCommand}" />
                <ui:Button Appearance="Primary" Content="Chọn file sao kê" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding OpenFileCommand}" />
            </StackPanel>
        </Grid>

        <!-- Lỗi file / lỗi luật -->
        <views:Banner Grid.Row="1" Margin="0,12,0,0" Title="Cần chú ý"
                      AccentBrush="{DynamicResource SystemFillColorCautionBrush}"
                      Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}"
                      Message="{Binding Messages}" />

        <!-- Bộ lọc -->
        <Grid Grid.Row="2" Margin="0,12,0,8"
              Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" />
            <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Tìm theo mô tả, ghi chú, nhóm, mã GD…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Content="Chọn tất cả" Appearance="Transparent" Command="{Binding SelectAllCommand}" />
                <ui:Button Content="Bỏ chọn" Appearance="Transparent" Command="{Binding UnselectAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Vùng kéo thả khi chưa có file -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DocumentArrowDown24" FontSize="48" HorizontalAlignment="Center" />
                <ui:TextBlock Margin="0,12,0,0" FontTypography="Subtitle" HorizontalAlignment="Center"
                              Text="Kéo thả file sao kê (.xlsx) vào đây" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}"
                           Text="hoặc bấm &quot;Chọn file sao kê&quot;. File chỉ được đọc trên máy này." />
            </StackPanel>
        </Border>

        <!-- Lưới giao dịch -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding RowsView}"
                  Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="40" EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" MinWidth="0"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelectable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ngày" Width="96" SortMemberPath="Model.SortKey">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellText}" Text="{Binding NgayText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Loại" Width="56" SortMemberPath="Loai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellText}" Text="{Binding Loai}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Số tiền" Width="110" SortMemberPath="SoTien">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SoTienText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpense}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Nhóm" Width="170" SortMemberPath="Nhom">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Margin="2,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding CategoryOptions}"
                                      Text="{Binding Nhom, UpdateSourceTrigger=LostFocus}"
                                      IsEnabled="{Binding IsSelectable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ví" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellText}" Text="{Binding Wallet}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ghi chú" Width="2*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="2,0" VerticalAlignment="Center"
                                     Text="{Binding GhiChu, UpdateSourceTrigger=LostFocus}"
                                     IsReadOnly="{Binding IsLocked}"
                                     ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Luật khớp" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellText}" Text="{Binding MatchedRule}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Trạng thái" Width="1.3*" MinWidth="120" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding StatusText}" />
                                <TextBlock Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ErrorText}" FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Chân trang: tổng + chạy -->
        <Grid Grid.Row="4" Margin="0,12,0,4"
              Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReadyCount, StringFormat='Sẽ nhập: {0} giao dịch'}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng chi: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalExpenseText}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng thu: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalIncomeText}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" Text="{Binding SummaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Bật lên khi có phần Automation (cần selector của Money Lover). -->
                <ui:Button Content="Chạy thử" Icon="{ui:SymbolIcon Beaker24}" Margin="0,0,8,0" IsEnabled="False"
                           ToolTipService.ShowOnDisabled="True"
                           ToolTip="Chưa có: cần soi selector của Money Lover (SPEC mục 12)." />
                <ui:Button Appearance="Primary" Content="Bắt đầu nhập" Icon="{ui:SymbolIcon Play24}" IsEnabled="False"
                           ToolTipService.ShowOnDisabled="True"
                           ToolTip="Chưa có: cần soi selector của Money Lover (SPEC mục 12)." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
