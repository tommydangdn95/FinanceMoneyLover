<UserControl x:Class="MoneyLoverAutoInput.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
             xmlns:c="clr-namespace:MoneyLoverAutoInput.App.Controls"
             xmlns:views="clr-namespace:MoneyLoverAutoInput.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + chọn file -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="Xem trước" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="DocumentTable24" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding FileName}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16,0,0,0"
                               Text="{Binding AccountMasked, StringFormat='Tài khoản: {0}'}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16,0,0,0"
                               Text="{Binding Period, StringFormat='Kỳ: {0}'}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Đọc lại file" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"
                           Command="{Binding ReloadCommand}" />
                <ui:Button Appearance="Primary" Content="Chọn file sao kê" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding OpenFileCommand}" />
            </StackPanel>
        </Grid>

        <!-- Lỗi file / lỗi luật -->
        <views:Banner Grid.Row="1" Margin="0,12,0,0" Title="Cần chú ý"
                      AccentBrush="{DynamicResource SystemFillColorCautionBrush}"
                      Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}"
                      Message="{Binding Messages}" />

        <!-- Bộ lọc -->
        <Grid Grid.Row="2" Margin="0,12,0,8"
              Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" />
            <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Tìm theo mô tả, ghi chú, nhóm, người nhận/gửi, mã GD…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Content="Chọn tất cả" Appearance="Transparent" Command="{Binding SelectAllCommand}" />
                <ui:Button Content="Bỏ chọn" Appearance="Transparent" Command="{Binding UnselectAllCommand}" />
                <ui:Button Content="Xóa dòng đang chọn" Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}"
                           ToolTip="Xóa các dòng đang bôi đen trên lưới (Ctrl/Shift + click để chọn nhiều; hoặc phím Delete)"
                           Command="{Binding DeleteRowsCommand}"
                           CommandParameter="{Binding SelectedItems, ElementName=RowsGrid}" />
                <ui:Button Content="Hoàn tác tất cả" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUndo24}"
                           ToolTip="Bỏ mọi chỉnh sửa, khôi phục dòng đã xóa và lựa chọn trong file này"
                           Command="{Binding ResetAllEditsCommand}" />
            </StackPanel>
        </Grid>

        <!-- Vùng kéo thả khi chưa có file -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DocumentArrowDown24" FontSize="48" HorizontalAlignment="Center" />
                <ui:TextBlock Margin="0,12,0,0" FontTypography="Subtitle" HorizontalAlignment="Center"
                              Text="Kéo thả file sao kê (.xlsx) vào đây" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}"
                           Text="hoặc bấm &quot;Chọn file sao kê&quot;. File chỉ được đọc trên máy này." />
            </StackPanel>
        </Border>

        <!-- Lưới giao dịch -->
        <!-- Chọn nhiều dòng: Ctrl/Shift + click (vào vùng trống của dòng, VD cột Trạng thái); phím Delete để xóa. -->
        <DataGrid x:Name="RowsGrid" Grid.Row="3" ItemsSource="{Binding RowsView}"
                  Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="40" EnableRowVirtualization="True">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteRowsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=RowsGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="8,0,0,0"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelectable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ngày" Width="138" SortMemberPath="Model.SortKey">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker Margin="2,0" VerticalAlignment="Center" MinWidth="0" Padding="8,4"
                                        SelectedDate="{Binding NgayDate, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateFormat="Short" IsEnabled="{Binding IsEditable}"
                                        ToolTip="{Binding OriginalSummary}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Loại" Width="84" SortMemberPath="Loai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="2,0" VerticalAlignment="Center" MinWidth="0" Padding="8,4"
                                      ItemsSource="{x:Static vm:TransactionRowViewModel.TypeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding LoaiOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Số tiền" Width="118" SortMemberPath="SoTien">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="2,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"
                                     Text="{Binding SoTienText, UpdateSourceTrigger=LostFocus}"
                                     IsReadOnly="{Binding IsLocked}" ToolTip="{Binding OriginalSummary}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpense}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Nhóm" Width="2*" MinWidth="200" SortMemberPath="Nhom">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <c:SearchComboBox Margin="2,0" VerticalAlignment="Center"
                                               ToolTip="{Binding MatchedRuleTooltip}"
                                               ItemsSource="{Binding CategoryOptions}"
                                               Value="{Binding Nhom, Mode=TwoWay}"
                                               IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ví" Width="130" SortMemberPath="Wallet">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <c:SearchComboBox Margin="2,0" VerticalAlignment="Center"
                                               ItemsSource="{Binding WalletOptions}"
                                               Value="{Binding Wallet, Mode=TwoWay}"
                                               IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ghi chú" Width="2*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="2,0" VerticalAlignment="Center"
                                     Text="{Binding GhiChu, UpdateSourceTrigger=LostFocus}"
                                     IsReadOnly="{Binding IsLocked}"
                                     ToolTip="{Binding OriginalSummary}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Người nhận / gửi" Width="1.4*" MinWidth="130"
                                        SortMemberPath="Model.CounterpartName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellText}" Text="{Binding CounterpartText}"
                                       ToolTip="{Binding CounterpartTooltip}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="90" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding StatusText}" />
                                <TextBlock Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ErrorText}" FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="⚠ Mã GD trùng" FontSize="11" ToolTip="{Binding WarningText}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowUndo24}"
                                           ToolTip="Hoàn tác chỉnh sửa của dòng này"
                                           Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.ResetRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon Delete24}"
                                           ToolTip="Xóa dòng này khỏi danh sách nhập (khôi phục được ở bộ lọc &quot;Đã xóa&quot;)"
                                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowReset24}"
                                           ToolTip="Khôi phục dòng đã xóa"
                                           Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.RestoreRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Chân trang: tổng + chạy -->
        <Grid Grid.Row="4" Margin="0,12,0,4"
              Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReadyCount, StringFormat='Sẽ nhập: {0} giao dịch'}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng chi: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalExpenseText}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng thu: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalIncomeText}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" Text="{Binding SummaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Chạy thử" Icon="{ui:SymbolIcon Beaker24}" Margin="0,0,8,0"
                           Command="{Binding DryRunCommand}"
                           ToolTip="Đi hết các bước với giao dịch đầu tiên nhưng KHÔNG bấm Lưu — để kiểm tra an toàn." />
                <ui:Button Appearance="Primary" Content="Bắt đầu nhập" Icon="{ui:SymbolIcon Play24}"
                           Command="{Binding StartImportCommand}"
                           ToolTip="Nhập các giao dịch đang chọn vào Money Lover trên điện thoại." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
