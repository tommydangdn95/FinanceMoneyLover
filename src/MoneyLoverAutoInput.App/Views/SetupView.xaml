<UserControl x:Class="MoneyLoverAutoInput.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
             xmlns:c="clr-namespace:MoneyLoverAutoInput.App.Controls"
             xmlns:views="clr-namespace:MoneyLoverAutoInput.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + nút lưu (luôn hiện, không cuộn mất) -->
        <Grid Grid.Row="0" Margin="0,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="Thiết lập" />
                <Border Margin="12,6,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Chưa lưu" Foreground="Black" FontSize="12" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Hoàn tác" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,8,0"
                           Command="{Binding RevertCommand}" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                           Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,16">
            <StackPanel>
                <views:Banner Title="Chào mừng! Thiết lập một lần trước khi nhập sao kê"
                              AccentBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                              Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}"
                              Message="Nhập tên ví và tên nhóm GIỐNG HỆT trong app Money Lover của bạn, rồi thêm luật để tự phân loại giao dịch. Bấm &quot;Lưu và bắt đầu&quot; khi xong. Có thể sửa lại bất cứ lúc nào ở mục Thiết lập." />

                <views:Banner Margin="0,8,0,0" Title="Kiểm tra lại"
                              AccentBrush="{DynamicResource SystemFillColorCautionBrush}"
                              Visibility="{Binding HasValidationMessages, Converter={StaticResource BoolToVisibility}}"
                              Message="{Binding ValidationMessages}" />

                <!-- 1. Ví -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. Ví" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Danh sách ví: mỗi dòng một ví, đúng tên CHÍNH XÁC như trong Money Lover (chỉ ví còn dùng). Ví mặc định là ví ứng với tài khoản ngân hàng của sao kê; trên Xem trước vẫn đổi được ví cho từng giao dịch." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Danh sách ví" />
                                <TextBox Margin="0,6,0,0" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding WalletsText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="Ví mặc định (bắt buộc)" />
                                <c:SearchComboBox Margin="0,6,0,0" Height="34" ItemsSource="{Binding KnownWallets}"
                                                   Value="{Binding DefaultWallet, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 2. Nhóm -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. Nhóm" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Mỗi dòng một nhóm, đúng tên (kể cả dấu) như trong Money Lover. Nhóm CON: thụt đầu dòng hoặc bắt đầu bằng dấu &quot;-&quot; ngay dưới nhóm cha. Ở nơi khác nhóm con hiện dạng &quot;Cha &gt; Con&quot;. Nhóm mặc định dùng cho giao dịch không khớp luật nào." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Nhóm Chi"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBox Margin="0,6,0,0" Height="320" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" FontFamily="Consolas, Segoe UI"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding ExpenseCategoriesText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <TextBlock Margin="0,10,0,4" Text="Nhóm Chi mặc định" />
                                <c:SearchComboBox Height="34" ItemsSource="{Binding ExpenseCategories}"
                                                   Value="{Binding DefaultExpenseCategory, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="Nhóm Thu"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBox Margin="0,6,0,0" Height="320" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" FontFamily="Consolas, Segoe UI"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding IncomeCategoriesText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <TextBlock Margin="0,10,0,4" Text="Nhóm Thu mặc định" />
                                <c:SearchComboBox Height="34" ItemsSource="{Binding IncomeCategories}"
                                                   Value="{Binding DefaultIncomeCategory, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 3. Luật -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="3. Luật phân loại" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Nếu mô tả giao dịch CHỨA một trong các từ khóa (không phân biệt dấu, hoa thường) thì gán nhóm. Luật ở trên được ưu tiên trước. &quot;Bỏ qua&quot; = không nhập giao dịch đó (ví dụ nạp ví MoMo)." />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="Thêm luật"
                                       Icon="{ui:SymbolIcon Add24}" Command="{Binding AddRuleCommand}" />
                        </Grid>

                        <DataGrid Margin="0,10,0,0" ItemsSource="{Binding Rules}" MaxHeight="420"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="44"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="36" Binding="{Binding Order}" />

                                <DataGridTemplateColumn Header="Từ khóa (cách nhau bởi dấu phẩy)" Width="1.3*" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Margin="2,0" VerticalAlignment="Center"
                                                     Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Loại" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Margin="2,0" VerticalAlignment="Center"
                                                      ItemsSource="{x:Static vm:RuleEditorViewModel.TypeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding TypeOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Hành động" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Margin="2,0" VerticalAlignment="Center"
                                                      ItemsSource="{x:Static vm:RuleEditorViewModel.ActionOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding ActionOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nhóm" Width="1.7*" MinWidth="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:SearchComboBox Margin="2,0" VerticalAlignment="Center"
                                                               ItemsSource="{Binding CategoryOptions}"
                                                               Value="{Binding Category, Mode=TwoWay}"
                                                               IsEnabled="{Binding IsImport}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Lên (ưu tiên hơn)"
                                                           Icon="{ui:SymbolIcon ArrowUp24}"
                                                           Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Xuống"
                                                           Icon="{ui:SymbolIcon ArrowDown24}"
                                                           Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Xóa luật"
                                                           Icon="{ui:SymbolIcon Delete24}"
                                                           Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>

                <!-- 4. Thử luật -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="4. Thử luật" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Dán một mô tả giao dịch từ sao kê để xem nó sẽ được xếp vào nhóm nào (dùng thiết lập đang sửa, chưa cần lưu)." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox PlaceholderText="Ví dụ: GRAB*A-123XYZ HCM"
                                        Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding TestTypeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding TestTypeOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TestResult}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
