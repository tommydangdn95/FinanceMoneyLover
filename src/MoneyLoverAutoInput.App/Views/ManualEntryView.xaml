<UserControl x:Class="MoneyLoverAutoInput.App.Views.ManualEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
             xmlns:c="clr-namespace:MoneyLoverAutoInput.App.Controls"
             xmlns:views="clr-namespace:MoneyLoverAutoInput.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ManualEntryViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="Nhập tay" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="Gõ các giao dịch không có trong sao kê (VD chi tiền mặt), rồi bấm &quot;Bắt đầu nhập&quot; để app tự nhập vào Money Lover. Danh sách được lưu tự động." />
        </StackPanel>

        <!-- Form thêm nhanh: Enter ở ô Số tiền / Ghi chú = Thêm -->
        <ui:Card Grid.Row="1" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ngày" />
                    <DatePicker MinWidth="0" Padding="8,4" SelectedDateFormat="Short"
                                SelectedDate="{Binding NewDate, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Loại" />
                    <ComboBox MinWidth="0" Padding="8,4" ItemsSource="{x:Static vm:TransactionRowViewModel.TypeOptions}"
                              DisplayMemberPath="Label" SelectedItem="{Binding NewType, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Số tiền" />
                    <TextBox x:Name="AmountBox" TextAlignment="Right" FontWeight="SemiBold"
                             ToolTip="45000, 45.000, 45k hoặc 1.5tr"
                             Text="{Binding NewAmountText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nhóm (gõ để tìm)" />
                    <c:SearchComboBox Height="34" ItemsSource="{Binding NewCategoryOptions}"
                                       Value="{Binding NewCategory, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ví" />
                    <c:SearchComboBox Height="34" ItemsSource="{Binding WalletOptions}"
                                       Value="{Binding NewWallet, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ghi chú" />
                    <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <ui:Button Grid.Column="6" VerticalAlignment="Bottom" Appearance="Primary" Content="Thêm"
                           Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
            </Grid>
        </ui:Card>

        <views:Banner Grid.Row="2" Margin="0,8,0,0" Title="Chưa thêm được"
                      AccentBrush="{DynamicResource SystemFillColorCautionBrush}"
                      Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"
                      Message="{Binding FormError}" />

        <!-- Danh sách -->
        <DataGrid Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="40">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="8,0,0,0"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelectable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ngày" Width="138">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker Margin="2,0" VerticalAlignment="Center" MinWidth="0" Padding="8,4"
                                        SelectedDate="{Binding NgayDate, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateFormat="Short" IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Loại" Width="84">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="2,0" VerticalAlignment="Center" MinWidth="0" Padding="8,4"
                                      ItemsSource="{x:Static vm:TransactionRowViewModel.TypeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding LoaiOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Số tiền" Width="118">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="2,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"
                                     Text="{Binding SoTienText, UpdateSourceTrigger=LostFocus}"
                                     IsReadOnly="{Binding IsLocked}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpense}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Nhóm" Width="2*" MinWidth="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <c:SearchComboBox Margin="2,0" VerticalAlignment="Center"
                                               ItemsSource="{Binding CategoryOptions}"
                                               Value="{Binding Nhom, Mode=TwoWay}"
                                               IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ví" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <c:SearchComboBox Margin="2,0" VerticalAlignment="Center"
                                               ItemsSource="{Binding WalletOptions}"
                                               Value="{Binding Wallet, Mode=TwoWay}"
                                               IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ghi chú" Width="2*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="2,0" VerticalAlignment="Center"
                                     Text="{Binding GhiChu, UpdateSourceTrigger=LostFocus}"
                                     IsReadOnly="{Binding IsLocked}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding StatusText}" />
                                <TextBlock Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ErrorText}" FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon Delete24}"
                                       ToolTip="Xóa khỏi danh sách"
                                       Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Chân trang -->
        <Grid Grid.Row="4" Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReadyCount, StringFormat='Sẽ nhập: {0} giao dịch'}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng chi: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalExpenseText}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Margin="24,0,0,0" Text="Tổng thu: " Style="{StaticResource SecondaryText}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding TotalIncomeText}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" Text="{Binding SummaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Dọn dòng đã nhập" Appearance="Transparent" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,0"
                           ToolTip="Bỏ các giao dịch đã nhập xong khỏi danh sách (không ảnh hưởng Money Lover)"
                           Command="{Binding ClearImportedCommand}" />
                <ui:Button Content="Chạy thử" Icon="{ui:SymbolIcon Beaker24}" Margin="0,0,8,0"
                           Command="{Binding DryRunCommand}"
                           ToolTip="Đi hết các bước với giao dịch đầu tiên nhưng KHÔNG bấm Lưu." />
                <ui:Button Appearance="Primary" Content="Bắt đầu nhập" Icon="{ui:SymbolIcon Play24}"
                           Command="{Binding StartImportCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
