<UserControl x:Class="MoneyLoverAutoInput.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MoneyLoverAutoInput.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <StackPanel Margin="8,16">
        <ui:TextBlock FontTypography="Title" Text="Cài đặt" />

        <ui:Card Margin="0,16,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Thư mục dữ liệu" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DataFolder}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Chứa cấu hình, state.json, log và ảnh chụp lỗi. Đây là dữ liệu tài chính cá nhân — không chia sẻ." />
                <ui:Button Margin="0,12,0,0" Content="Mở thư mục dữ liệu"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="File cấu hình" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ConfigFile}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Sửa luật phân loại, nhóm, ví mặc định và selector trong file này. Lưu file là app tự áp dụng; nếu không, bấm Tải lại." />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <ui:Button Content="Mở file cấu hình" Icon="{ui:SymbolIcon DocumentEdit24}"
                               Command="{Binding OpenConfigFileCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Tải lại cấu hình" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding ReloadConfigCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
